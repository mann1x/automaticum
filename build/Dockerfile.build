# Build environment for automaticum's native (cgo) parts.
#
# manylinux_2_28 pairs an old glibc (2.28) with a current GCC whose newer C++
# runtime parts are linked statically. That is what the prebuilt DuckDB
# archives are built on: they need libstdc++ symbols from GCC 11 and later,
# which a plain Debian 11 toolchain (GCC 10) cannot resolve. A binary linked
# here runs on glibc 2.28 and later, which covers our oldest host (2.31).
#
# Build per architecture: --build-arg ARCH=x86_64 GOARCH=amd64, or
# ARCH=aarch64 GOARCH=arm64 (the latter runs under emulation on an amd64 host).
ARG ARCH=x86_64
FROM quay.io/pypa/manylinux_2_28_${ARCH}

ARG GOARCH=amd64
ARG GO_VERSION=1.25.10
ARG PROTOC_VERSION=28.3
# lancedb-go's pinned dependencies build with the older compiler; lance-c
# needs the newer one. Both are installed and each build names the one it uses.
ARG RUST_VERSION=1.89.0
ARG RUST_VERSION_NEW=1.99.0

RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-${GOARCH}.tar.gz | tar -C /usr/local -xz

RUN case "${GOARCH}" in amd64) P=x86_64 ;; arm64) P=aarch_64 ;; esac \
    && curl -fsSL -o /tmp/protoc.zip \
        https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${P}.zip \
    && unzip -q /tmp/protoc.zip -d /usr/local && rm /tmp/protoc.zip

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION} \
    && /opt/cargo/bin/rustup toolchain install ${RUST_VERSION_NEW} --profile minimal

ENV PATH=/usr/local/go/bin:/opt/cargo/bin:$PATH
WORKDIR /src
